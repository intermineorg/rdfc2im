<?xml version="1.0"?>
<!-- Schema extensions approved in SPECIFICATION_15sep26.md section 8 (that document is not in this
     repo; see SPEC-DECISIONS.md), kept out of the per-source additions so they survive
     regeneration.  Unioned into humanmine-items_additions.xml by `rdfc2im project`.  Only the
     *delta* to the live model is listed (Pathway.identifier/name/shortName/curated and
     Gene/Protein.pathways already exist in reactome_additions.xml). -->
<classes>
  <!-- gene loader: D1 side-stepped - typeOfGene lives here, not in ncbi-gene/human-gene -->
  <class name="Gene" is-interface="true">
    <attribute name="typeOfGene" type="java.lang.String"/>
  </class>
  <!-- reactome Phase 1 -->
  <class name="Pathway" is-interface="true">
    <attribute name="description" type="java.lang.String"/>
    <reference name="organism" referenced-type="Organism"/>
    <collection name="reactions" referenced-type="PathwayReaction" reverse-reference="pathway"/>
  </class>
  <class name="PathwayReaction" is-interface="true">
    <attribute name="identifier" type="java.lang.String"/>
    <attribute name="displayName" type="java.lang.String"/>
    <attribute name="description" type="java.lang.String"/>
    <attribute name="reactionType" type="java.lang.String"/>
    <attribute name="conversionDirection" type="java.lang.String"/>
    <attribute name="ecNumber" type="java.lang.String"/>
    <reference name="pathway" referenced-type="Pathway" reverse-reference="reactions"/>
  </class>
  <!-- clinvar. `diseases` is emitted by items.py as an IMPLICIT link (clinvar's disease_label
       column has no `via` - see columns.tsv's root="Allele" - so items.py infers the collection
       from the row's root class), which project.py's reverse-reference carrying never sees
       (that only scans explicit mapped-column writers). Confirmed live: BUILD FAILED loading
       humanmine-clinvar - "MetaDataException: Collection not found in class: Allele.diseases" -
       50373 real <collection name="diseases"> references in clinvar's own items.xml, dropped
       entirely otherwise. Both sides copied verbatim from stock clinvar's own
       clinvar_additions.xml (the source we replace) - same class/field, not a new invention. -->
  <class name="Allele" is-interface="true">
    <attribute name="reviewStatus" type="java.lang.String"/>
    <attribute name="submissionCount" type="java.lang.Integer"/>
    <collection name="diseases" referenced-type="Disease" reverse-reference="alleles"/>
  </class>
  <!-- extends BioEntity, not just Annotatable like stock clinvar's own declaration: every
       loaded item is auto-tagged with its DataSet by the loader, and BioEntity is what
       declares `dataSets` (core.xml) - confirmed live, BUILD FAILED with "Collection not found
       in class: Disease.dataSets" when Disease only extended Annotatable. Adding a standalone
       Disease.dataSets field instead (kept extends="Annotatable") does NOT work either -
       confirmed live: mergeModels still fails, because DataSet.bioEntities' own declared
       referenced-type is "BioEntity", and the merger checks that reverse-reference type
       compatibility, not just field-name existence - Disease has to actually BE a BioEntity.
       In a full HumanMine deployment some other disease-touching source (we run none) must
       independently declare this same extends, merging it in; here it only comes from us. -->
  <class name="Disease" is-interface="true" extends="BioEntity">
    <collection name="alleles" referenced-type="Allele" reverse-reference="diseases"/>
  </class>
  <!-- uniprot. Another items.py-implicit pair (no `via` column maps either side), copied
       verbatim from stock uniprot's own uniprot_additions.xml (a source we run alongside, not
       replace - alongside sources' own additions aren't in our humanmine-items' isolated
       mergeModels either, same reasoning as clinvar/huge-gwas above). Confirmed live: BUILD
       FAILED loading humanmine-uniprot - "Collection not found in class: Protein.ecNumbers". -->
  <class name="Protein" is-interface="true">
    <collection name="ecNumbers" referenced-type="ECNumber" reverse-reference="proteins"/>
  </class>
  <class name="ECNumber" is-interface="true">
    <collection name="proteins" referenced-type="Protein" reverse-reference="ecNumbers"/>
  </class>
  <!-- mesh: MeshTerm has only `name`; the D-identifier lets pubmed and mesh rows merge -->
  <class name="MeshTerm" is-interface="true">
    <attribute name="identifier" type="java.lang.String"/>
  </class>
  <!-- huge-gwas. associatedGenes is another items.py-implicit collection (no `via` column maps
       it - see Allele.diseases above for why project.py's carrying never sees these), copied
       verbatim from stock huge-gwas's own huge-gwas_additions.xml (the source gwascatalog
       replaces) - one-way, no reverse-reference declared there either, so none added here.
       Confirmed live: BUILD FAILED loading humanmine-gwascatalog - "Collection not found in
       class: GWASResult.associatedGenes". -->
  <class name="GWASResult" is-interface="true">
    <attribute name="mappedTraitUri" type="java.lang.String"/>
    <collection name="associatedGenes" referenced-type="Gene"/>
  </class>
</classes>
