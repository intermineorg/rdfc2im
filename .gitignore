# Inputs: reconstructed from upstream, not part of this repo.
#   in/config/<source>/        dbcls/rdf-config           config/
#   in/intermine/bio/          intermine/intermine        bio/
#   in/humanmine-bio-sources/  intermine/humanmine-bio-sources
#   in/humanmine_project.xml   intermine/humanmine        project.xml
#   in/humanmine_model.{xml,json}  humanmine.org/humanmine/service/model?format=...
# `make inputs` rebuilds the whole tree; see README.md, "in/ layout".
in/

# Derived per-source output.  The two mapping_* files and their hidden .base
# snapshots ARE the curation state and are tracked (see the negations below);
# everything else under out/ is regenerated by `rdfc2im translate`.
out/*
!out/*/
out/*/*
!out/*/mapping_subjects.tsv
!out/*/mapping_predicates.sssom.tsv
!out/*/.mapping_subjects.base.tsv
!out/*/.mapping_predicates.base.sssom.tsv

# Bulk data never belongs in git.
out/*/raw/
out/*/tsv/
out/*/items/

# Trial stack build output (see LOAD-TRIAL.md); the compose file itself is tracked.
trial/artifacts/
.trial-home
# Sandbox-local BIND_ADDR override full-build.sh generates (see its own header comment) -
# never commit this, only the tracked trial/docker-compose.yml.
trial/docker-compose.local.yml

# humanmine-items is registered as a real Gradle subproject (see settings.gradle wiring in
# tools/full-build.sh) - its own build/ output lands here, not under TRIAL_HOME.
humanmine-items/build/

__pycache__/
*.pyc
.pytest_cache/
.build-logs/

# Checksummed cache of everything a build fetched (see rdfc2im/rawcache.py, BUILD.md).
cached_raw_data/
